import requests
import random

pokemon_list = [
    "venusaur", 
    "squirtle",
    "metapod",
    "beedrill",
    "rattata"
]
pokemon = random.choice(pokemon_list)
url = 'https://pokeapi.co/api/v2/pokemon' + pokemon
response = requests.get(url)
data = response.json()
print("Who's That Pokemon?")
print("Height:", data["height"])
print("Weight:", data["weight"])
for i in range(3):
    guess = input("Guess:")
    if guess.lower() == data ["name"]:
        print ("You win")
        break
    else:
        print("you lose")
      

